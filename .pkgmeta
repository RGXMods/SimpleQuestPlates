package-as: SimpleQuestPlates

enable-nolib-creation: no

ignore:
  - .github
  - .gitignore
  - README.md
  - .pkgmeta
  - .gitlab-ci.yml
  - .claude
  - AGENTS.md
  - GEMINI.md
  - docs
  - tests

plain-copy:
  - LICENSE

manual-changelog:
  filename: docs/CHANGES.md
  markup-type: markdown

license-output: LICENSE
